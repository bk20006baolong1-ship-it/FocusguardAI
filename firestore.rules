rules_version = '2';
// FocusGuard accesses Firestore only from the Flask server with a service
// account (Admin/Server SDKs bypass these rules). Browsers and mobile clients
// must never read or write the database directly, so everything is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
