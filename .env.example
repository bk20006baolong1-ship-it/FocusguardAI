# FocusGuard environment configuration (copy to .env; .env is git-ignored).
# Only placeholders here. Never commit real values.

# development | production. Production refuses insecure settings.
FOCUSGUARD_ENV=development

# Flask session signing key. REQUIRED in production (>= 32 random chars), e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=<generate-a-random-secret>

# Comma separated list of allowed browser origins for Socket.IO.
# Empty = same origin only. '*' is rejected in production.
ALLOWED_ORIGINS=

# Seed demo accounts (development only; ignored in production).
SEED_DEMO_ACCOUNTS=true
DEMO_ACCOUNT_PASSWORD=<choose-a-demo-password>

# Database: 'sqlite' (default) or 'firestore'
DATABASE_TYPE=sqlite
SQLITE_PATH=focusguard.db

# Firestore only
USE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
# Path to a service-account key stored OUTSIDE the repository
GOOGLE_APPLICATION_CREDENTIALS=</absolute/path/outside/repo/service-account.json>

# Optional pipeline threshold overrides (see focusguard/config.py)
# FG_FACE_SIM_THRESHOLD=0.45
# FG_FACE_MIN_MARGIN=0.08
# FG_EAR_THRESHOLD=0.22
# FG_LATE_AFTER_SECONDS=300

# Camera settings (Cài đặt › Camera). Key that encrypts saved camera passwords /
# EZVIZ verification codes. REQUIRED in production when cameras with a password are
# saved (without it they cannot be used: fail safe). Generate once and keep it secret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Development without a key: a local key is created in .focusguard/ (git-ignored).
FG_CAMERA_CREDENTIAL_KEY=<generate-a-fernet-key>
# Camera-network policy (where cameras may be). Set to your camera network(s) / VLAN (comma separated CIDRs):
# only these are ever contacted. Unset: this machine's own /24 subnet; in production a manually typed camera
# address must then be listed here or in FG_CAMERA_ALLOWED_HOSTS (cameras found by "Tìm camera" work).
# FG_CAMERA_ALLOWED_NETWORKS=192.168.1.0/24
# Optional: individual camera hosts / networks / host names that are always allowed.
# FG_CAMERA_ALLOWED_HOSTS=
# Optional: camera ports (default: RTSP / ONVIF ports 80,88,554,2020,5000,5554,7447,8000,8080,8554,8899,8999,10554).
# FG_CAMERA_ALLOWED_PORTS=
